{ config, pkgs, ... }:

{
  imports = [
    
  ];

  wayland.windowManager.hyprland = {
    enable = true;
    systemd.enable = false;
    configType = "lua";

    settings.config = {
      autogenerated = false;
      ecosystem.no_update_news = true;

      input = {
        kb_layout = "fr";
        kb_variant = "";
        numlock_by_default = true;

        touchpad = {
          tap_to_click = true;
          natural_scroll = false;
        };
      };

      general = {
        gaps_in = 5;
        gaps_out = 5;
        border_size = 2;
        col.active_border = config.theme.colors.primary;
        layout = "dwindle";
      };

      decoration  = {
        rounding = 12;
        active_opacity = 1.0;
        inactive_opacity = 1.0;
        shadow = {
          enabled = true;
          range = 30;
          render_power = 4;
          offset = "0 5";
          color = "rgba(00000070)";
        };
      };

      dwindle = {
		    preserve_split = true;
	    };

      misc = {
        disable_hyprland_logo = true;
        disable_splash_rendering = true;
        background_color = "rgb(000000)";
      };
    };
  };
}